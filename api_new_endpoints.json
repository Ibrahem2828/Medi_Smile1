{
  "version": "1.0",
  "description": "New/updated API endpoints introduced for AI-driven critical cases and assignment decisions.",
  "endpoints": [
    {
      "name": "Create AI Critical Case (Patient Acceptance)",
      "method": "POST",
      "path": "/api/cases/ai/create/",
      "auth": "Bearer (patient)",
      "body": {
        "title": "string (optional)",
        "description": "string (optional)",
        "university_id": "uuid (required)",
        "ai_report": {
          "diagnosis": "string",
          "severity_level": "high|moderate|low",
          "urgency": "urgent|non_urgent",
          "patient_explanation": "string",
          "arabert_diagnosis": "string",
          "arabert_score": "number",
          "arabert_second": "string",
          "arabert_second_score": "number",
          "metadata": "object"
        }
      },
      "responses": {
        "201": {
          "status": "success",
          "message": "Case created from AI diagnosis.",
          "data": {
            "id": "uuid",
            "title": "string",
            "status": "pending_assignment",
            "is_public": true,
            "is_ai_critical": true,
            "university": "uuid",
            "patient": "uuid",
            "ai_metadata": "object"
          }
        },
        "400": { "status": "error", "message": "validation error", "errors": "details" },
        "403": { "status": "error", "message": "Only patients can accept AI treatment and create cases." }
      }
    },
    {
      "name": "Assign Supervisor to Case",
      "method": "PATCH",
      "path": "/api/cases/{case_id}/assign-supervisor/",
      "auth": "Bearer (supervisor / tech_support / university_admin per permissions)",
      "body": {
        "supervisor_id": "uuid (optional if requester is supervisor)"
      },
      "responses": {
        "200": { "id": "uuid", "supervisor": "uuid", "university": "uuid", "status": "pending_assignment", "is_public": true },
        "400/403": { "detail": "validation or permission error" }
      }
    },
    {
      "name": "Create Assignment Request (Student)",
      "method": "POST",
      "path": "/api/cases/{case_id}/assignment-requests/",
      "auth": "Bearer (student)",
      "body": {
        "message": "string (optional)"
      },
      "responses": {
        "201": { "id": "uuid", "case": "uuid", "student": "uuid", "status": "pending" },
        "400/403": { "detail": "validation or permission error" }
      }
    },
    {
      "name": "Decision on Assignment Request (Supervisor)",
      "method": "PATCH",
      "path": "/api/cases/assignment-requests/{request_id}/decision/",
      "auth": "Bearer (supervisor of the case)",
      "body": {
        "decision": "accept|reject",
        "supervisor_response": "string (optional)"
      },
      "responses": {
        "200": {
          "id": "uuid",
          "status": "accepted|rejected",
          "supervisor_response": "string",
          "updated_at": "datetime"
        },
        "400/403": { "detail": "validation or permission error" }
      }
    },
    {
      "name": "AI Diagnosis (with suggestions)",
      "method": "POST",
      "path": "/api/ai/diagnosis/",
      "auth": "Bearer (patient)",
      "body": {
        "symptoms_text": "string (required)",
        "patient_id": "uuid (optional, must match auth user)",
        "image_urls": ["url", "... optional"]
      },
      "responses": {
        "201": {
          "diagnosis": { "...": "AIDiagnosis fields" },
          "primary_suggestion": { "...": "highest severity/urgency item" },
          "next_suggestion": { "...": "next high item or null" },
          "all_suggestions": ["... full ordered list ..."]
        },
        "400/403": { "detail": "validation or permission error" }
      }
    }
  ]
}
