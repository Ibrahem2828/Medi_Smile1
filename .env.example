# Copy to .env locally. Do not commit a real .env or paste secrets in tickets.
DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=api.example.org
CORS_ALLOWED_ORIGINS=https://app.example.org
CSRF_TRUSTED_ORIGINS=https://app.example.org
DATABASE_URL=postgresql://medismile:replace-password@db:5432/medismile
# false only for a Coolify PostgreSQL resource reachable over its private network.
DATABASE_SSL_REQUIRE=false
DATABASE_CONN_MAX_AGE=600
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
AI_SYMPTOMS_URL=https://nlp.medismile.xn--mgbaab0cxheq.tech
AI_VISION_URL=https://vision.medismile.xn--mgbaab0cxheq.tech
AI_FUSION_URL=https://fusion.medismile.xn--mgbaab0cxheq.tech
AI_ENGINE_TIMEOUT=30
# Optional bearer tokens (only for engines behind auth, e.g. a private Hugging Face Space)
AI_SYMPTOMS_AUTH_TOKEN=
AI_VISION_AUTH_TOKEN=
AI_FUSION_AUTH_TOKEN=
PRIVATE_MEDIA_ROOT=/app/private_media
BACKUP_DIRECTORY=/app/backups
PRIVATE_FILE_STORAGE_BACKEND=django.core.files.storage.FileSystemStorage
# Restores are allowed only in a disposable recovery environment.
BACKUP_RESTORE_ENABLED=false
BACKUP_RESTORE_DATABASE_URL=
BACKUP_RESTORE_MEDIA_ROOT=
