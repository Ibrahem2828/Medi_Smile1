{
  "service": {
    "name": "MediSmile Messaging",
    "version": "3.0.0",
    "base_url": "/api/messaging",
    "timezone": "UTC",
    "languages": ["en"],
    "principle": "Context-only messaging scoped to a case or course."
  },
  "overview": {
    "summary": "Messaging is available only within a valid case assignment (patient-student) or a shared course (student-supervisor).",
    "goals": [
      "Provide secure, scoped communication tied to academic/clinical context.",
      "Prevent global chat and enforce role-based access.",
      "Ensure audit-ready records for messages.",
      "Support REST and WebSocket channels."
    ],
    "non_goals": [
      "Global/direct messaging outside case or course context.",
      "Anonymous or public channels.",
      "Message edits or deletions."
    ]
  },
  "thread_types": {
    "case": {
      "name": "Case Thread (Patient <-> Student)",
      "created_when": "A case is assigned to a student and is active (assigned/in_progress).",
      "participants": ["patient", "assigned_student"],
      "viewers": ["patient", "assigned_student", "case_supervisor", "university_admin", "tech_support"],
      "can_send": ["patient", "assigned_student"],
      "constraints": [
        "Case must have patient and assigned student.",
        "Case status must be ASSIGNED or IN_PROGRESS.",
        "One room per case (idempotent create)."
      ]
    },
    "course": {
      "name": "Course Thread (Student <-> Supervisor)",
      "created_when": "A course is active and the student is enrolled; supervisor is assigned.",
      "participants": ["enrolled_student", "course_supervisor"],
      "viewers": ["enrolled_student", "course_supervisor", "university_admin", "tech_support"],
      "can_send": ["enrolled_student", "course_supervisor"],
      "constraints": [
        "Course must be active and have a supervisor.",
        "Student must be enrolled in the course.",
        "One room per (course, student, supervisor) tuple (idempotent create)."
      ]
    }
  },
  "models": {
    "UserSummary": {
      "fields": {
        "id": "uuid",
        "first_name": "string",
        "last_name": "string"
      }
    },
    "Room": {
      "fields": {
        "id": "uuid",
        "thread_type": "enum(case, course)",
        "case_id": "uuid|null",
        "course_id": "uuid|null",
        "participant_patient": "UserSummary|null",
        "participant_student": "UserSummary|null",
        "participant_supervisor": "UserSummary|null",
        "created_at": "datetime",
        "messages": "array<Message>"
      },
      "rules": [
        "case threads require case_id, patient, student; supervisor is not a chat participant.",
        "course threads require course_id, student, supervisor; patient is not allowed.",
        "messages are read-only and may be paginated depending on global DRF settings."
      ]
    },
    "Message": {
      "fields": {
        "id": "uuid",
        "sender": "UserSummary",
        "content": "string (1..2000)",
        "sent_at": "datetime",
        "is_system": "boolean"
      },
      "rules": [
        "Messages are immutable after creation.",
        "Empty content is rejected.",
        "Send is restricted by thread type and case/course state."
      ]
    }
  },
  "authorization": {
    "roles": ["patient", "student", "supervisor", "university_admin", "tech_support"],
    "rooms": {
      "list": {
        "patient": "rooms where participant_patient is the user",
        "student": "rooms where participant_student is the user",
        "supervisor": "case rooms where case.supervisor is the user or course rooms where participant_supervisor is the user",
        "university_admin": "rooms scoped to the admin university",
        "tech_support": "all rooms"
      },
      "create": {
        "case": "patient or assigned student only",
        "course": "enrolled student or course supervisor only"
      }
    },
    "messages": {
      "read": "room participants; scoped university admin; tech support",
      "send": {
        "case": "patient or assigned student only",
        "course": "student or supervisor only"
      }
    }
  },
  "api": {
    "pagination": {
      "style": "drf-default",
      "note": "Pagination depends on global REST framework settings."
    },
    "endpoints": [
      {
        "method": "GET",
        "path": "/threads/",
        "description": "List accessible rooms.",
        "response": {
          "status": 200,
          "schema": "array<Room> or paginated list"
        },
        "errors": [
          {"status": 401, "code": "unauthorized"},
          {"status": 403, "code": "forbidden"}
        ]
      },
      {
        "method": "POST",
        "path": "/threads/",
        "description": "Create or get a room by context.",
        "body": {
          "thread_type": "case|course (default case)",
          "case_id": "uuid (required for case)",
          "course_id": "uuid (required for course)",
          "student_id": "uuid (required for supervisors creating course threads)",
          "case": "uuid (alias for case_id; optional)"
        },
        "response": {
          "status": 201,
          "schema": "Room"
        },
        "errors": [
          {"status": 400, "code": "validation_error"},
          {"status": 401, "code": "unauthorized"},
          {"status": 403, "code": "forbidden"},
          {"status": 404, "code": "not_found"}
        ]
      },
      {
        "method": "GET",
        "path": "/threads/{room_id}/",
        "description": "Retrieve a room by id.",
        "response": {
          "status": 200,
          "schema": "Room"
        },
        "errors": [
          {"status": 401, "code": "unauthorized"},
          {"status": 403, "code": "forbidden"},
          {"status": 404, "code": "not_found"}
        ]
      },
      {
        "method": "GET",
        "path": "/threads/{room_id}/messages/",
        "description": "List messages in a room.",
        "response": {
          "status": 200,
          "schema": "array<Message> or paginated list"
        },
        "errors": [
          {"status": 401, "code": "unauthorized"},
          {"status": 403, "code": "forbidden"},
          {"status": 404, "code": "not_found"}
        ]
      },
      {
        "method": "POST",
        "path": "/threads/{room_id}/messages/",
        "description": "Send a message in a room.",
        "body": {"content": "string (1..2000)"},
        "response": {
          "status": 201,
          "schema": "Message"
        },
        "errors": [
          {"status": 400, "code": "validation_error"},
          {"status": 401, "code": "unauthorized"},
          {"status": 403, "code": "forbidden"},
          {"status": 404, "code": "not_found"}
        ]
      },
      {
        "method": "GET",
        "path": "/rooms/",
        "description": "Create room using rooms endpoint (alias of POST /threads/).",
        "response": {
          "status": 405,
          "schema": "Method not allowed"
        }
      },
      {
        "method": "POST",
        "path": "/rooms/",
        "description": "Create or get a room by context (alias of POST /threads/).",
        "body": "same as POST /threads/",
        "response": {
          "status": 201,
          "schema": "Room"
        }
      },
      {
        "method": "GET",
        "path": "/rooms/{room_id}/",
        "description": "Retrieve a room by id (alias of GET /threads/{room_id}/).",
        "response": {
          "status": 200,
          "schema": "Room"
        }
      },
      {
        "method": "GET",
        "path": "/rooms/{room_id}/messages/",
        "description": "List messages (alias of GET /threads/{room_id}/messages/).",
        "response": {
          "status": 200,
          "schema": "array<Message> or paginated list"
        }
      },
      {
        "method": "POST",
        "path": "/rooms/{room_id}/messages/",
        "description": "Send message (alias of POST /threads/{room_id}/messages/).",
        "body": {"content": "string (1..2000)"},
        "response": {
          "status": 201,
          "schema": "Message"
        }
      },
      {
        "method": "GET",
        "path": "/messages/{message_id}/",
        "description": "Retrieve a single message.",
        "response": {
          "status": 200,
          "schema": "Message"
        },
        "errors": [
          {"status": 401, "code": "unauthorized"},
          {"status": 403, "code": "forbidden"},
          {"status": 404, "code": "not_found"}
        ]
      }
    ],
    "websocket": {
      "path": "ws/chat/{room_id}/",
      "events": ["message.created"],
      "send_payload": {"content": "string"},
      "receive_payload": {
        "id": "uuid",
        "sender": "string (email)",
        "content": "string",
        "sent_at": "datetime"
      }
    },
    "no_delete_endpoints": true
  },
  "audit": {
    "events": [
      "messaging.room.created",
      "messaging.room.retrieved",
      "messaging.message.sent",
      "messaging.message.sent.ws"
    ],
    "content_in_audit": false,
    "metadata_only": true
  },
  "validation": {
    "content_length": "1..2000",
    "thread_open_required": true,
    "participant_only": true
  }
}
