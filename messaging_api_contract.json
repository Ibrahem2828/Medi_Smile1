{
  "service": {
    "name": "MediSmile Messaging",
    "version": "2.0.0",
    "base_url": "/api/messaging",
    "timezone": "UTC",
    "languages": ["ar", "en"],
    "principle": "Context-only messaging: no global chats."
  },
  "overview": {
    "summary": "خدمة محادثات موجهة بالسياق (حالة طبية أو مادة تعليمية) تربط المريض/الطالب/المشرف ضمن نطاق الجامعة.",
    "goals": [
      "تسهيل التواصل السريري والتعليمـي داخل السياق الصحيح",
      "منع التسريب بين الجامعات أو الحالات",
      "دعم التدقيق والحوكمة",
      "العمل مع WebSocket للأحداث الفورية"
    ],
    "non_goals": [
      "لا محادثات عامة أو غرف مفتوحة",
      "لا رسائل مجهولة",
      "لا محتوى غير مرتبط بـ Case أو Material"
    ]
  },
  "principles": {
    "context_driven": "كل رسالة مرتبطة بـ Case أو Material.",
    "relation_based_access": "المشاركون فقط هم أصحاب العلاقة بالحالة أو المادة.",
    "no_global_chat": "لا توجد قنوات عامة.",
    "audit_ready": "تخزين سجل ميتاداتا كامل للأحداث."
  },
  "thread_types": {
    "case": {
      "name": "Case Thread (Student-Patient-Supervisor)",
      "created_when": "عند قبول الحالة وإتاحتها للتواصل السريري.",
      "usage": ["استشارات مريض", "متابعة حالة", "تنسيق مواعيد"],
      "constraints": [
        "المشاركون: patient + assigned student + supervisor",
        "Read-only للمشاركين غير المفوضين",
        "يتبع حالة الحالة (يغلق عند case.closed)"
      ]
    },
    "material": {
      "name": "Material Thread (Student-Supervisor)",
      "created_when": "تكليف مادة أو مهمة تعليمية.",
      "usage": ["نقاش المادة", "مراجعة المهام", "تغذية راجعة"],
      "constraints": [
        "المشاركون: student + supervisor",
        "يغلق عند انتهاء التكليف"
      ]
    }
  },
  "models": {
    "Thread": {
      "fields": {
        "id": "uuid",
        "thread_type": "enum(case, material)",
        "case_id": "uuid|null",
        "material_id": "uuid|null",
        "participants": "array<uuid>",
        "is_closed": "boolean",
        "created_at": "datetime",
        "updated_at": "datetime"
      },
      "rules": [
        "thread_type يحدد السياق والقيود",
        "يجب وجود case_id أو material_id حسب النوع",
        "participants مشتقة من سياق الحالة/المادة"
      ]
    },
    "Message": {
      "fields": {
        "id": "uuid",
        "thread_id": "uuid",
        "sender_id": "uuid",
        "content": "string (1..2000)",
        "message_type": "enum(text, system)",
        "is_read": "boolean",
        "created_at": "datetime"
      },
      "rules": [
        "غير قابلة للتعديل بعد الإرسال",
        "القراءة تسجل per-recipient",
        "الرسائل النظامية يستخدمها الباك"
      ]
    }
  },
  "authorization": {
    "roles": ["patient", "student", "supervisor", "university_admin", "tech_support"],
    "threads": {
      "list": {
        "patient": "case threads فقط",
        "student": "case threads (assigned) + material threads",
        "supervisor": "case threads (supervised) + material threads",
        "university_admin": "ممنوع",
        "tech_support": "قراءة تدقيقية عند الحاجة"
      },
      "retrieve": "نفس قواعد list مع تحقق المشارك",
      "create": "يُنشأ عبر الخدمات عند توفر سياق صالح (لا إنشاء حر)"
    },
    "messages": {
      "send": {
        "patient": "case thread فقط",
        "student": "case/material حسب السياق",
        "supervisor": "case/material حسب السياق",
        "university_admin": "ممنوع",
        "tech_support": "ممنوع"
      },
      "read": "المشارك فقط"
    }
  },
  "lifecycle": {
    "thread": {
      "states": ["active", "closed"],
      "transitions": [
        "case -> closed عند إغلاق الحالة",
        "material -> closed عند انتهاء التكليف",
        "closed => يمنع الإرسال؛ القراءة مسموحة"
      ]
    }
  },
  "api": {
    "pagination": {
      "style": "cursor",
      "params": { "limit": "int (default 20, max 100)", "cursor": "string|null" }
    },
    "endpoints": [
      {
        "method": "GET",
        "path": "/threads/",
        "description": "قائمة الخيوط ضمن نطاق المشارك.",
        "query": { "thread_type": "case|material|null", "is_closed": "bool|null", "case_id": "uuid|null", "material_id": "uuid|null", "limit": "int", "cursor": "string|null" },
        "response": { "status": 200, "schema": { "count": "int", "next_cursor": "string|null", "results": "array<Thread>" } },
        "errors": [{ "status": 401, "code": "unauthorized" }]
      },
      {
        "method": "GET",
        "path": "/threads/{id}/",
        "description": "تفاصيل خيط مع آخر الرسائل.",
        "response": { "status": 200, "schema": { "thread": "Thread", "messages": { "count": "int", "next_cursor": "string|null", "results": "array<Message>" } } },
        "errors": [{ "status": 401, "code": "unauthorized" }, { "status": 403, "code": "forbidden" }, { "status": 404, "code": "not_found" }]
      },
      {
        "method": "POST",
        "path": "/threads/{id}/messages/",
        "description": "إرسال رسالة جديدة في خيط مفتوح.",
        "body": { "content": "string (1..2000)", "message_type": "text|system (default text)" },
        "response": { "status": 201, "schema": "Message" },
        "errors": [
          { "status": 400, "code": "validation_error" },
          { "status": 401, "code": "unauthorized" },
          { "status": 403, "code": "forbidden" },
          { "status": 404, "code": "not_found" },
          { "status": 409, "code": "thread_closed" }
        ]
      },
      {
        "method": "POST",
        "path": "/messages/{id}/read/",
        "description": "تحديث حالة القراءة لرسالة.",
        "body": { "is_read": "boolean (true)" },
        "response": { "status": 200, "schema": { "id": "uuid", "is_read": "boolean", "read_at": "datetime" } },
        "errors": [{ "status": 401, "code": "unauthorized" }, { "status": 403, "code": "forbidden" }, { "status": 404, "code": "not_found" }]
      },
      {
        "method": "GET",
        "path": "/threads/{id}/messages/",
        "description": "جلب رسائل الخيط مع ترقيم متقدم.",
        "query": { "limit": "int", "cursor": "string|null" },
        "response": { "status": 200, "schema": { "count": "int", "next_cursor": "string|null", "results": "array<Message>" } },
        "errors": [{ "status": 401, "code": "unauthorized" }, { "status": 403, "code": "forbidden" }, { "status": 404, "code": "not_found" }]
      }
    ],
    "websocket": {
      "path": "ws/chat/<thread_id>/",
      "events": ["message.created", "message.read", "thread.closed"]
    },
    "no_delete_endpoints": true
  },
  "notifications": {
    "events": [
      "message.created -> notification to other participants",
      "system.message -> high priority"
    ]
  },
  "audit": {
    "records": ["thread.created", "message.sent", "message.read", "unauthorized.send_attempt", "unauthorized.thread_access"],
    "content_in_audit": false,
    "metadata_only": true
  },
  "validation": {
    "content_length": "1..2000",
    "thread_open_required": true,
    "participant_only": true
  },
  "indexes": {
    "messages": ["thread_id", "created_at"],
    "threads": ["thread_type", "case_id", "material_id", "is_closed"]
  },
  "filters": ["thread_type", "is_closed", "case_id", "material_id", "date_range"],
  "tests": [
    "participant access",
    "thread scope per role/university",
    "thread closure lock",
    "pagination cursors",
    "unauthorized send/read attempts"
  ]
}
